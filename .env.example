# Plik konfiguracyjny środowiska - PRZYKŁAD
# Skopiuj ten plik jako .env i uzupełnij własnymi danymi

# Konfiguracja bazy danych PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bet_assistant
DB_USER=postgres
DB_PASSWORD=your-password-here

# Database URL for Prisma (constructed from above values)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# API Football Configuration
# Get your free API key at: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=your-api-football-key-here
API_FOOTBALL_HOST=v3.football.api-sports.io
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Rate Limiting (FREE plan: 100 req/day, PREMIUM: 7500+ req/day)
RATE_LIMIT_REQUESTS_PER_DAY=100
RATE_LIMIT_REQUESTS_PER_HOUR=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bet_assistant.log

# Google Sheets Configuration
# ID arkusza (z URL: https://docs.google.com/spreadsheets/d/[ID]/edit)
GOOGLE_SHEETS_ID=your-google-sheets-id-here

# n8n Webhook Configuration
# Wygeneruj silny klucz API dla autoryzacji webhooków n8n
# Przykład generowania: openssl rand -hex 32
# Ten klucz musi być taki sam w n8n i tutaj
N8N_WEBHOOK_KEY=your-secure-random-key-here-change-me

# Email Notifications (opcjonalne, dla powiadomień z n8n i systemu)
# Dla Gmail: użyj hasła aplikacji (App Password), nie zwykłego hasła
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Server Configuration
PORT=3000
